<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MacTemp.App"
             xmlns:local="using:MacTemp"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray-icon.png" ToolTipText="CherryHud">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="CherryHud" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Afficher / Masquer" Click="ToggleVisibility_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quitter CherryHud" Click="Quit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>