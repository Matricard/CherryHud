<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacTemp.ViewModels"
        xmlns:controls="using:MacTemp.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        Width="236" Height="216"
        x:Class="MacTemp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen">

    <!-- Carte HUD MangoHud complète ; extérieur 100% transparent -->
    <Border CornerRadius="16"
            Background="#E613141C"
            BorderThickness="0"
            Padding="14,10">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
            <!-- Header : Nom du jeu / App + Batterie + Heure -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0"
                           Text="{Binding TrackedAppName}"
                           Foreground="#9E9E9E"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BatteryDisplay}"
                               IsVisible="{Binding HasBattery}"
                               Foreground="#81C784"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentTime}"
                               Foreground="#757575"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <!-- Ligne de séparation fine -->
            <Rectangle Grid.Row="1" Height="1" Fill="#1AFFFFFF" Margin="0,0,0,6" />

            <!-- GPU Row (MangoHud Coral) -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5">
                <Border Grid.Column="0"
                        Background="#26FF5E7E"
                        CornerRadius="5"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="GPU"
                               Foreground="#FF5E7E"
                               FontSize="11"
                               FontWeight="Heavy" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GpuTemp}"
                               Foreground="{Binding GpuStatusColor}"
                               FontSize="15"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding GpuUsage}"
                               Foreground="#FF8A80"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GpuVram}"
                               Foreground="#B0BEC5"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- CPU Row (MangoHud Cyan) -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5">
                <Border Grid.Column="0"
                        Background="#2600E5FF"
                        CornerRadius="5"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="CPU"
                               Foreground="#00E5FF"
                               FontSize="11"
                               FontWeight="Heavy" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CpuTemp}"
                               Foreground="{Binding CpuStatusColor}"
                               FontSize="15"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding CpuUsage}"
                               Foreground="#80D8FF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- RAM Row (MangoHud Blue) -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5">
                <Border Grid.Column="0"
                        Background="#26448AFF"
                        CornerRadius="5"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="RAM"
                               Foreground="#448AFF"
                               FontSize="11"
                               FontWeight="Heavy" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RamDisplay}"
                               Foreground="#E0E0E0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RamPercent}"
                               Foreground="#82B1FF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- FPS Row (MangoHud Lime Green) -->
            <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,6">
                <Border Grid.Column="0"
                        Background="#2600E676"
                        CornerRadius="5"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="FPS"
                               Foreground="#00E676"
                               FontSize="11"
                               FontWeight="Heavy" />
                </Border>

                <Button Grid.Column="2"
                        Command="{Binding RequestPermissionCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FpsDisplay}"
                                   Foreground="{Binding FpsStatusColor}"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding FrametimeDisplay}"
                                   Foreground="#A5D6A7"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Graphique Framerate / Frametime Sparkline MangoHud -->
            <controls:FpsGraphControl Grid.Row="6"
                                     Height="34"
                                     History="{Binding FpsHistory}"
                                     TargetFps="{Binding TargetFps}"
                                     Margin="0,2,0,0" />
        </Grid>
    </Border>
</Window>
