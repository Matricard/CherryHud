<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacTemp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        Width="190" Height="96"
        x:Class="MacTemp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen">

    <!-- Carte arrondie avec fond sombre ; tout l'extérieur de la carte est 100% transparent -->
    <Border CornerRadius="16"
            Background="#D916171F"
            BorderThickness="0"
            Padding="14,10">
        <Grid RowDefinitions="*,*">
            <!-- CPU Row -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Background="#2600E5FF"
                        CornerRadius="6"
                        Padding="7,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="CPU"
                               Foreground="#00E5FF"
                               FontSize="11"
                               FontWeight="Heavy" />
                </Border>

                <TextBlock Grid.Column="2"
                           Text="{Binding CpuTemp}"
                           Foreground="{Binding CpuStatusColor}"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- GPU Row -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Background="#26FF5376"
                        CornerRadius="6"
                        Padding="7,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="GPU"
                               Foreground="#FF5376"
                               FontSize="11"
                               FontWeight="Heavy" />
                </Border>

                <TextBlock Grid.Column="2"
                           Text="{Binding GpuTemp}"
                           Foreground="{Binding GpuStatusColor}"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
