<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CherryHud.App"
             xmlns:local="using:CherryHud"
             Name="CherryHud"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray-icon.png" ToolTipText="CherryHud">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="CherryHud" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Show / Hide" Click="ToggleVisibility_OnClick" />
                        <NativeMenuItem Header="Auto Mode (In-Game Only)"
                                        ToggleType="CheckBox"
                                        IsChecked="True"
                                        Click="ResetAutoMode_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Settings..." Click="Settings_OnClick" />
                        <NativeMenuItem Header="Check for Updates..." Click="CheckUpdates_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit CherryHud" Click="Quit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>