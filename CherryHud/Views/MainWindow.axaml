<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CherryHud.ViewModels"
        xmlns:controls="using:CherryHud.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        Width="236"
        SizeToContent="Height"
        Opacity="{Binding OverlayOpacity}"
        x:Class="CherryHud.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        Title="CherryHud"
        Icon="/Assets/logo.png"
        SystemDecorations="None"
        WindowStartupLocation="Manual">

    <Window.KeyBindings>
        <KeyBinding Gesture="Cmd+Q" Command="{Binding QuitCommand}" />
    </Window.KeyBindings>

    <!-- Carte HUD avec theme dynamique et lueur néon optionnelle -->
    <Border CornerRadius="16"
            Background="{Binding CardBackground}"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="{Binding CardBorderThickness}"
            BoxShadow="{Binding CardBoxShadow}"
            Padding="14,16,14,10">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <!-- GPU Row -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5" IsVisible="{Binding ShowGpu}">
                <TextBlock Grid.Column="0"
                           Text="GPU"
                           Foreground="{Binding GpuBadgeFg}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GpuUsageValue}"
                                   Foreground="{Binding GpuValueColor}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding GpuUsageUnit}"
                                   Foreground="{Binding GpuValueColor}"
                                   FontSize="10.5"
                                   FontWeight="Heavy"
                                   VerticalAlignment="Top"
                                   Margin="1,1,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GpuTempValue}"
                                   Foreground="{Binding GpuStatusColor}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding GpuTempUnit}"
                                   Foreground="{Binding GpuStatusColor}"
                                   FontSize="10.5"
                                   FontWeight="Heavy"
                                   VerticalAlignment="Top"
                                   Margin="1,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- CPU Row -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5" IsVisible="{Binding ShowCpu}">
                <TextBlock Grid.Column="0"
                           Text="CPU"
                           Foreground="{Binding CpuBadgeFg}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CpuUsageValue}"
                                   Foreground="{Binding CpuValueColor}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding CpuUsageUnit}"
                                   Foreground="{Binding CpuValueColor}"
                                   FontSize="10.5"
                                   FontWeight="Heavy"
                                   VerticalAlignment="Top"
                                   Margin="1,1,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CpuTempValue}"
                                   Foreground="{Binding CpuStatusColor}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding CpuTempUnit}"
                                   Foreground="{Binding CpuStatusColor}"
                                   FontSize="10.5"
                                   FontWeight="Heavy"
                                   VerticalAlignment="Top"
                                   Margin="1,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- VRAM Row -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5" IsVisible="{Binding ShowVram}">
                <TextBlock Grid.Column="0"
                           Text="{Binding GpuMemoryLabel}"
                           Foreground="{Binding VramBadgeFg}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GpuVramValue}"
                               Foreground="{Binding VramValueColor}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding GpuVramUnit}"
                               Foreground="{Binding VramValueColor}"
                               FontSize="10.5"
                               FontWeight="Heavy"
                               VerticalAlignment="Top"
                               Margin="1,1,0,0" />
                </StackPanel>
            </Grid>

            <!-- RAM Row -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5" IsVisible="{Binding ShowRam}">
                <TextBlock Grid.Column="0"
                           Text="RAM"
                           Foreground="{Binding RamBadgeFg}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RamValue}"
                               Foreground="{Binding RamValueColor}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding RamUnit}"
                               Foreground="{Binding RamValueColor}"
                               FontSize="10.5"
                               FontWeight="Heavy"
                               VerticalAlignment="Top"
                               Margin="1,1,0,0" />
                </StackPanel>
            </Grid>

            <!-- BAT Row -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,5" IsVisible="{Binding ShowBatteryRow}">
                <TextBlock Grid.Column="0"
                           Text="BAT"
                           Foreground="{Binding BatBadgeFg}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Batterie vectorielle libre de droits & haute précision (Licence MIT) -->
                    <Viewbox Width="24" Height="14" VerticalAlignment="Center" Margin="0,0,1,0">
                        <Canvas Width="24" Height="14">
                            <!-- Cadre de la batterie -->
                            <Rectangle Canvas.Left="1.2" Canvas.Top="1.5"
                                       Width="18.5" Height="11"
                                       RadiusX="3" RadiusY="3"
                                       Stroke="{Binding BatValueColor}"
                                       StrokeThickness="1.2"
                                       Fill="Transparent" />

                            <!-- Borne positive droite -->
                            <Path Data="M 19.7,4.5 C 20.8,4.5 21.6,5.2 21.6,6 L 21.6,8 C 21.6,8.8 20.8,9.5 19.7,9.5 Z"
                                  Fill="{Binding BatValueColor}" />

                            <!-- Niveau de charge dynamique selon pourcentage (sur batterie) -->
                            <Rectangle Canvas.Left="2.5" Canvas.Top="2.8"
                                       Width="{Binding BatteryFillWidth}" Height="8.4"
                                       RadiusX="1.6" RadiusY="1.6"
                                       Fill="{Binding BatValueColor}"
                                       IsVisible="{Binding !IsBatteryCharging}" />

                            <!-- Éclair horizontal centré à l'intérieur de la batterie (en recharge) -->
                            <Path Data="M 5.0,7.2 L 10.8,7.2 L 9.2,10.2 L 16.5,6.8 L 10.8,6.8 L 12.2,3.8 Z"
                                  Fill="{Binding BatValueColor}"
                                  IsVisible="{Binding IsBatteryCharging}" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatteryValue}"
                                   Foreground="{Binding BatValueColor}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding BatteryUnit}"
                                   Foreground="{Binding BatValueColor}"
                                   FontSize="10.5"
                                   FontWeight="Heavy"
                                   VerticalAlignment="Top"
                                   Margin="1,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- FPS Row -->
            <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,6" IsVisible="{Binding ShowFps}">
                <TextBlock Grid.Column="0"
                           Text="FPS"
                           Foreground="{Binding FpsBadgeFg}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Command="{Binding RequestPermissionCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FpsValue}"
                                       Foreground="{Binding FpsStatusColor}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding FpsUnit}"
                                       Foreground="{Binding FpsStatusColor}"
                                       FontSize="10.5"
                                       FontWeight="Heavy"
                                       VerticalAlignment="Top"
                                       Margin="1,1,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FrametimeValue}"
                                       Foreground="{Binding FrametimeValueColor}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding FrametimeUnit}"
                                       Foreground="{Binding FrametimeValueColor}"
                                       FontSize="10.5"
                                       FontWeight="Heavy"
                                       VerticalAlignment="Top"
                                       Margin="1,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Graphique Frametime Sparkline (ms par trame) -->
            <controls:FpsGraphControl Grid.Row="6"
                                      Height="34"
                                      Frametimes="{Binding FrametimeHistory}"
                                      TargetFrametimeMs="{Binding TargetFrametimeMs}"
                                      LineColor="{Binding GraphLineColor}"
                                      DotColor="{Binding GraphDotColor}"
                                      IsVisible="{Binding ShowGraph}"
                                      Margin="0,2,0,0" />
        </Grid>
    </Border>
</Window>
