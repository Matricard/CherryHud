<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CherryHud.ViewModels"
        x:Class="CherryHud.Views.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Title="{Binding Loc.UpdateWindowTitle}"
        Icon="/Assets/logo.png"
        Width="460" Height="440"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="Transparent">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Gesture="Cmd+W" Command="{Binding CloseCommand}" />
    </Window.KeyBindings>

    <Panel>
        <!-- Teinte d'arrière-plan sombre obsidian fusionnée avec la barre de titre -->
        <Border x:Name="WindowBackgroundBorder" Background="#9E030408">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto" Margin="22,36,22,18">
        <!-- En-tête -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Border Grid.Column="0"
                    Width="44" Height="44"
                    CornerRadius="11"
                    ClipToBounds="True"
                    BoxShadow="0 4 12 0 #33000000"
                    Margin="0,0,14,0">
                <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding StatusTitle}"
                           Foreground="#FFFFFF"
                           FontSize="16"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#8A8D9F"
                           FontSize="11.5"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Corps / Contenu dynamique selon l'état -->
        <Border Grid.Row="1"
                Background="#202230"
                CornerRadius="10"
                Padding="16,14">
            <Grid>
                <!-- État 1 : Chargement -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="14"
                            IsVisible="{Binding IsLoading}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="180" Height="4"
                                 Foreground="#FF2A6D" />
                    <TextBlock Text="{Binding Loc.UpdateQueryingGitHub}"
                               Foreground="#8A8D9F"
                               FontSize="11.5"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- État 2 : Mise à jour disponible -->
                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding HasUpdate}">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ReleaseTitle}"
                                       Foreground="#FF2A6D"
                                       FontSize="13.5"
                                       FontWeight="Bold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LatestVersionText}"
                                       Foreground="#7ED884"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding AssetInfoText}"
                                   Foreground="#9E9E9E"
                                   FontSize="11"
                                   IsVisible="{Binding AssetInfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Changelog / Notes de version -->
                    <Border Grid.Row="1"
                            Background="#161722"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,6">
                        <ScrollViewer>
                            <TextBlock Text="{Binding Changelog}"
                                       Foreground="#D0D2DE"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       FontFamily="Monospace" />
                        </ScrollViewer>
                    </Border>
                    
                    <TextBlock Grid.Row="2"
                               Text="{Binding CurrentVersionText}"
                               Foreground="#6E7182"
                               FontSize="10.5"
                               Margin="2,4,0,0" />
                </Grid>

                <!-- État 3 : Logiciel à jour -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            IsVisible="{Binding IsUpToDate}">
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#267ED884"
                            HorizontalAlignment="Center">
                        <TextBlock Text="✓"
                                   Foreground="#7ED884"
                                   FontSize="24"
                                   FontWeight="Heavy"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Loc.UpdateUpToDateSubtitle}"
                               Foreground="#FFFFFF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentVersionText}"
                               Foreground="#8A8D9F"
                               FontSize="11.5"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- État 4 : Erreur -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            IsVisible="{Binding HasError}">
                    <Border Width="44" Height="44"
                            CornerRadius="22"
                            Background="#26FF2A6D"
                            HorizontalAlignment="Center">
                        <TextBlock Text="!"
                                   Foreground="#FF2A6D"
                                   FontSize="22"
                                   FontWeight="Heavy"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Loc.UpdateErrorSubtitle}"
                               Foreground="#FFFFFF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#8A8D9F"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="300"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- État 5 : Téléchargement et installation en cours -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="14"
                            IsVisible="{Binding IsDownloading}">
                    <ProgressBar Value="{Binding DownloadProgress}"
                                 Minimum="0" Maximum="100"
                                 Width="280" Height="6"
                                 CornerRadius="3"
                                 Foreground="#7ED884"
                                 Background="#161722" />
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DownloadProgressText}"
                                   Foreground="#FFFFFF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Loc.UpdateAutoRestartNote}"
                                   Foreground="#8A8D9F"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre d'action inférieure -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <!-- Bouton secondaire (Voir GitHub ou Réessayer) -->
            <Button Grid.Column="0"
                    Content="{Binding Loc.UpdateViewOnGitHub}"
                    Command="{Binding OpenReleaseCommand}"
                    Background="Transparent"
                    Foreground="#9DA1B8"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Padding="0"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsVisible="{Binding HasUpdate}" />

            <Button Grid.Column="0"
                    Content="{Binding Loc.UpdateRetry}"
                    Command="{Binding CheckUpdatesCommand}"
                    Background="Transparent"
                    Foreground="#9DA1B8"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Padding="0"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsVisible="{Binding HasError}" />

            <!-- Boutons principaux -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Content="{Binding Loc.CloseButton}"
                        Command="{Binding CloseCommand}"
                        Background="#26FFFFFF"
                        Foreground="#CCCCCC"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        Padding="16,7"
                        Cursor="Hand" />

                <Button Content="{Binding Loc.UpdateButton}"
                        Command="{Binding InstallUpdateCommand}"
                        Background="#267ED884"
                        Foreground="#7ED884"
                        FontSize="12"
                        FontWeight="Bold"
                        CornerRadius="8"
                        Padding="18,7"
                        Cursor="Hand"
                        IsVisible="{Binding HasUpdate}" />
            </StackPanel>
        </Grid>
    </Grid>
    </Panel>
</Window>
