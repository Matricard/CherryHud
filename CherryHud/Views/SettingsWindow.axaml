<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CherryHud.ViewModels"
        x:Class="CherryHud.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Loc.WindowTitle}"
        Icon="/Assets/logo.png"
        Width="470" Height="600"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="Transparent">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding $parent[Window].Close}" />
        <KeyBinding Gesture="Cmd+W" Command="{Binding $parent[Window].Close}" />
    </Window.KeyBindings>

    <Panel>
        <!-- Teinte d'arrière-plan : sombre obsidian transparent quand active, gris fumée foncé quand inactive -->
        <Border x:Name="WindowBackgroundBorder" Background="#8006070E">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto" Margin="22,46,22,18">
        <!-- Header (positionné sous les boutons classiques macOS) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="10"
                    ClipToBounds="True"
                    BoxShadow="0 4 12 0 #33000000"
                    Margin="0,0,12,0">
                <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Loc.HeaderTitle}"
                           Foreground="#FFFFFF"
                           FontSize="17"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding Loc.HeaderSubtitle}"
                           Foreground="#8A8D9F"
                           FontSize="11.5" />
            </StackPanel>
        </Grid>

        <!-- Body / Tabs -->
        <TabControl Grid.Row="1">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#8A8D9F" />
                    <Setter Property="Padding" Value="14,8" />
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#FF2A6D" />
                </Style>
            </TabControl.Styles>

            <!-- Onglet 1 : Affichage -->
            <TabItem Header="{Binding Loc.TabDisplay}">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="14">
                        <!-- Language Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.LanguageCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.LanguageCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedLanguageIndex}"
                                          Width="170"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Français" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Theme Card -->
                        <Border Background="#4E1C1F2D" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.ThemeCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.ThemeCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedThemeIndex}"
                                          Width="170"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="{Binding Loc.ThemeClassic}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Températures en blanc Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.WhiteTempTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.WhiteTempSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding KeepTemperaturesWhite}"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>

                        <!-- Mode Automatique Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.AutoModeTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.AutoModeSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding AutoGameMode}"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>

                        <!-- Position Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.PositionTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.PositionSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedPositionIndex}"
                                          Width="170"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="{Binding Loc.PositionTopLeft}" />
                                    <ComboBoxItem Content="{Binding Loc.PositionTopRight}" />
                                    <ComboBoxItem Content="{Binding Loc.PositionBottomLeft}" />
                                    <ComboBoxItem Content="{Binding Loc.PositionBottomRight}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Opacité Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc.OpacityTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OpacityPercent, StringFormat='{}{0}%'}"
                                               Foreground="#FF2A6D"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="40" Maximum="100"
                                        Value="{Binding OpacityPercent}"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 2 : Métriques -->
            <TabItem Header="{Binding Loc.TabMetrics}">
                <ScrollViewer Margin="0,12,0,0">
                    <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="10">
                            <!-- GPU -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#26FF5E7E" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="GPU" Foreground="#FF5E7E" FontSize="10" FontWeight="Heavy" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricGpu}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGpu}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- CPU -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#2600E5FF" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="CPU" Foreground="#00E5FF" FontSize="10" FontWeight="Heavy" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricCpu}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowCpu}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- VRAM -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#26BA68C8" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="VRAM" Foreground="#BA68C8" FontSize="10" FontWeight="Heavy" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricVram}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowVram}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- RAM -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#26448AFF" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="RAM" Foreground="#448AFF" FontSize="10" FontWeight="Heavy" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricRam}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowRam}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- BAT -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#2681C784" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="BAT" Foreground="#81C784" FontSize="10" FontWeight="Heavy" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricBattery}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowBattery}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- FPS -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#2600E676" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="FPS" Foreground="#00E676" FontSize="10" FontWeight="Heavy" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricFps}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowFps}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- Graphique -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📈" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.MetricGraph}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGraph}" OnContent="" OffContent="" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 3 : Système & Rendu -->
            <TabItem Header="{Binding Loc.TabAdvanced}">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="14">
                        <!-- Libellé Mémoire GPU -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.GpuMemLabelTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.GpuMemLabelSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedGpuMemoryLabelIndex}"
                                          Width="130"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="VRAM" />
                                    <ComboBoxItem Content="GPU MEM" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Rafraîchissement Graphique -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.GraphFpsTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.GraphFpsSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedGraphFpsIndex}"
                                          Width="130"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="60 FPS" />
                                    <ComboBoxItem Content="120 FPS" />
                                    <ComboBoxItem Content="30 FPS" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Screen Recording Permission Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Loc.ScreenCaptureTitle}"
                                           Foreground="#FFFFFF"
                                           FontSize="12.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Loc.ScreenCaptureSubtitle}"
                                           Foreground="#8A8D9F"
                                           FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding PermissionStatusText}"
                                               Foreground="{Binding PermissionStatusColor}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Loc.OpenSystemSettingsButton}"
                                            Command="{Binding OpenSystemSettingsCommand}"
                                            Background="#2600E5FF"
                                            Foreground="#00E5FF"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 4 : À propos -->
            <TabItem Header="{Binding Loc.TabAbout}">
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <!-- App Icon -->
                        <Border Width="72" Height="72"
                                CornerRadius="18"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                BoxShadow="0 6 20 0 #40000000"
                                Margin="0,0,0,10">
                            <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
                        </Border>

                        <!-- Titre & Version -->
                        <TextBlock Text="CherryHud"
                                    Foreground="#FFFFFF"
                                    FontSize="20"
                                    FontWeight="Heavy"
                                    HorizontalAlignment="Center" />

                        <TextBlock Text="Version 0.9.0 • .NET 10"
                                    Foreground="#D41630"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,4" />

                        <TextBlock Text="{Binding Loc.AboutDesc}"
                                    Foreground="#9E9E9E"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14" />

                        <!-- Carte récapitulative des fonctionnalités -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,14"
                                Width="380">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.AboutFeat1}"
                                               Foreground="#DCDCDC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🎮" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.AboutFeat2}"
                                               Foreground="#DCDCDC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🍒" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.AboutFeat3}"
                                               Foreground="#DCDCDC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Carte Mises à jour -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,12"
                                Width="380">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Loc.SoftwareUpdatesTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.SoftwareUpdatesSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="10.5" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding Loc.CheckButton}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        Background="#267ED884"
                                        Foreground="#7ED884"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        CornerRadius="6"
                                        Padding="12,5"
                                        Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- Auteur & Licence -->
                        <TextBlock Text="{Binding Loc.AuthorText}"
                                   Foreground="#7E8092"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding Loc.LicenseText}"
                                   Foreground="#5E6070"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Content="{Binding Loc.ResetDefaultsButton}"
                    Command="{Binding ResetDefaultsCommand}"
                    Background="Transparent"
                    Foreground="#8A8D9F"
                    FontSize="11.5"
                    Padding="0"
                    BorderThickness="0"
                    Cursor="Hand" />

            <Button Grid.Column="2"
                    Content="{Binding Loc.CloseButton}"
                    Click="Close_OnClick"
                    Background="#2600E676"
                    Foreground="#00E676"
                    FontSize="12"
                    FontWeight="Bold"
                    CornerRadius="8"
                    Padding="22,7"
                    Cursor="Hand" />
        </Grid>
    </Grid>
</Panel>
</Window>
