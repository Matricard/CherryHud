<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CherryHud.ViewModels"
        x:Class="CherryHud.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Loc.WindowTitle}"
        Icon="/Assets/logo.png"
        Width="680" Height="580"
        MinWidth="680"
        MinHeight="580"
        CanResize="True"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="Transparent">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding $parent[Window].Close}" />
        <KeyBinding Gesture="Cmd+W" Command="{Binding $parent[Window].Close}" />
    </Window.KeyBindings>

    <Panel>
        <!-- Teinte d'arrière-plan : sombre obsidian transparent (~62%) quand active, gris fumée foncé quand inactive -->
        <Border x:Name="WindowBackgroundBorder" Background="#9E030408">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <Grid RowDefinitions="*,Auto" Margin="18,44,20,16">
        <!-- Body / Tabs -->
        <TabControl Grid.Row="0"
                    TabStripPlacement="Left"
                    Padding="18,0,0,0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="3" Width="170" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Foreground" Value="#8A8D9F" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="7" />
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_LayoutRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.12" />
                                    </Transitions>
                                </Border.Transitions>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>

                <!-- Unselected tab hover -->
                <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="#1AFFFFFF" />
                </Style>
                <Style Selector="TabItem:pointerover">
                    <Setter Property="Foreground" Value="#D0D3E0" />
                </Style>

                <!-- Selected tab -->
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="#2E3140" />
                    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>

                <!-- Selected tab hover -->
                <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="#383C4E" />
                </Style>
            </TabControl.Styles>

            <!-- Onglet 1 : Général -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Path Width="15" Height="15"
                              Stretch="Uniform"
                              Fill="#4EA2FF"
                              VerticalAlignment="Center"
                              Data="M4 5h8v2H4zm12 0h4v2h-4zm-2-2h2v6h-2zM4 11h2v2H4zm6 0h10v2H10zm-2-2h2v6H8zM4 17h10v2H4zm14 0h2v2h-2zm-2-2h2v6h-2z" />
                        <TextBlock Text="{Binding Loc.TabGeneral}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0" Padding="0,0,10,0">
                    <StackPanel Spacing="9">
                        <!-- Language Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.LanguageCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.LanguageCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedLanguageIndex}"
                                          Width="145"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Français" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Mode Automatique Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.AutoModeTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.AutoModeSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding AutoGameMode}"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>

                        <!-- Lancer au démarrage Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.LaunchAtLoginTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.LaunchAtLoginSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding LaunchAtLogin}"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>

                        <!-- Position Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.PositionTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.PositionSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PositionOptions}"
                                          SelectedIndex="{Binding SelectedPositionIndex}"
                                          Width="145"
                                          FontSize="11.5" />
                            </Grid>
                        </Border>

                        <!-- Screen Recording Permission Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Loc.ScreenCaptureTitle}"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Loc.ScreenCaptureSubtitle}"
                                           Foreground="#8A8D9F"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding PermissionStatusText}"
                                               Foreground="{Binding PermissionStatusColor}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Loc.OpenSystemSettingsButton}"
                                            Command="{Binding OpenSystemSettingsCommand}"
                                            Background="#242838"
                                            Foreground="#FFFFFF"
                                            BorderBrush="#383D54"
                                            BorderThickness="1"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            CornerRadius="6"
                                            Padding="12,5"
                                            Cursor="Hand">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="#32384D" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#4C5474" />
                                            </Style>
                                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="#1C202E" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 2 : Métriques -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="#7ED884"
                              StrokeThickness="2.4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              VerticalAlignment="Center"
                              Data="M2 12h4l3-9 4.5 18 3.5-12 2 3H22" />
                        <TextBlock Text="{Binding Loc.TabMetrics}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0" Padding="0,0,10,0">
                    <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,8">
                        <StackPanel Spacing="8">
                            <!-- GPU -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#661422" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="GPU" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricGpu}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGpu}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- CPU -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#0E3D4F" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="CPU" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricCpu}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowCpu}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- VRAM -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#4E1A5B" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="VRAM" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricVram}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowVram}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- RAM -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#172F5E" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="RAM" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricRam}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowRam}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- BAT -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding IsLaptop}">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#523C0F" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="BAT" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricBattery}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowBattery}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" IsVisible="{Binding IsLaptop}" />

                            <!-- FPS -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#0F4725" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="FPS" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricFps}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowFps}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- Graphique -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#0F4725" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="MS" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricGraph}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGraph}" OnContent="" OffContent="" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 3 : À propos -->
            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Path Width="16" Height="16"
                                  Stretch="Uniform"
                                  Fill="#FF6482"
                                  VerticalAlignment="Center"
                                  Data="M16 13h-.5c-.7-1.3-1.2-3-1.7-4.7l.9.9c2.7 2.1 5.1 1.7 5.1 1.7s.7-3.8-2-5.8c-2.3-1.8-4.4-1.8-5-1.7c-.1-.6-.1-1.1-.2-1.5l-1.4.1c0 3.2-2.7 9.1-3.6 11c-2 .2-3.6 1.9-3.6 4c0 2.2 1.8 4 4 4c1.1 0 2-.4 2.7-1.1c-.4-.9-.7-1.9-.7-2.9s.3-2 .7-2.9c-.4-.4-1-.7-1.5-.9c.7-1.5 1.9-4.2 2.7-6.8c.4 2.3 1.2 5 2.2 7.1c-1.2.7-2.1 2-2.1 3.5c0 2.2 1.8 4 4 4s4-1.8 4-4s-1.8-4-4-4m-8 2.5c-.8 0-1.5.7-1.5 1.5h-1c0-1.4 1.1-2.5 2.5-2.5zm8 0c-.8 0-1.5.7-1.5 1.5h-1c0-1.4 1.1-2.5 2.5-2.5z" />
                            <TextBlock Text="{Binding Loc.TabAbout}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                IsVisible="{Binding IsUpdateAvailable}"
                                Background="#FF9F0A"
                                CornerRadius="8"
                                Width="15" Height="15"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="↓"
                                       Foreground="#FFFFFF"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0" />
                        </Border>
                    </Grid>
                </TabItem.Header>
                <ScrollViewer Margin="0" Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0">
                        <!-- App Icon -->
                        <Border Width="144" Height="144"
                                CornerRadius="32"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                BoxShadow="0 10 32 0 #50000000"
                                Margin="0,0,0,12">
                            <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
                        </Border>

                        <!-- Titre & Version -->
                        <TextBlock Text="CherryHud"
                                   Foreground="#FFFFFF"
                                   FontSize="22"
                                   FontWeight="Heavy"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding CurrentVersionText}"
                                   Foreground="#7ED884"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,6" />

                        <TextBlock Text="{Binding Loc.AboutDesc}"
                                    Foreground="#9E9E9E"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14" />

                        <!-- Carte GitHub Repo -->
                        <Button Command="{Binding OpenGitHubRepoCommand}"
                                Background="#24141724"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,8"
                                Width="380"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="#301A2035" />
                                    <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                </Style>
                            </Button.Styles>
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <Path Grid.Column="0"
                                      Width="18" Height="18"
                                      Fill="#FFFFFF"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Loc.GitHubCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.GitHubCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="10.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="↗"
                                           Foreground="#8A8D9F"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Carte Licence MIT -->
                        <Button Command="{Binding OpenLicenseCommand}"
                                Background="#24141724"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,8"
                                Width="380"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="#301A2035" />
                                    <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                </Style>
                            </Button.Styles>
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <Path Grid.Column="0"
                                      Width="16" Height="16"
                                      Fill="#FFFFFF"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Loc.LicenseCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.LicenseCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="10.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="↗"
                                           Foreground="#8A8D9F"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Carte Mises à jour -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,12"
                                Width="380">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding UpdateCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdateCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding Loc.UpdateButton}"
                                        Command="{Binding OpenUpdateWindowCommand}"
                                        Background="#267ED884"
                                        Foreground="#7ED884"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        CornerRadius="6"
                                        Padding="12,5"
                                        Cursor="Hand"
                                        IsVisible="{Binding IsUpdateAvailable}" />
                            </Grid>
                        </Border>

                        <!-- Auteur, Technologie & Licence -->
                        <TextBlock Text="{Binding Loc.AuthorText}"
                                   Foreground="#7E8092"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding Loc.BuiltWithAvaloniaText}"
                                   Foreground="#6B6E82"
                                   FontSize="10.5"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="{Binding Loc.LicenseText}"
                                   Foreground="#5E6070"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <Button Grid.Column="0"
                    Content="{Binding Loc.ResetDefaultsButton}"
                    Command="{Binding RequestResetDefaultsCommand}"
                    Background="Transparent"
                    Foreground="#8A8D9F"
                    FontSize="11.5"
                    FontWeight="Medium"
                    Padding="10,6"
                    CornerRadius="6"
                    Width="170"
                    HorizontalContentAlignment="Left"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="#1AFFFFFF" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="#33FFFFFF" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Grid>

    <!-- Modal de confirmation de réinitialisation -->
    <Border IsVisible="{Binding IsResetConfirmationVisible}"
            Background="#D8000000">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="380"
                Background="#1C1E2A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,20"
                BoxShadow="0 16 48 0 #CC000000">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Loc.ResetConfirmTitle}"
                               Foreground="#FFFFFF"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Loc.ResetConfirmMessage}"
                           Foreground="#B0B3C5"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="17" />

                <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                    <Button Grid.Column="0"
                            Content="{Binding Loc.CancelButton}"
                            Command="{Binding CancelResetDefaultsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#1AFFFFFF"
                            Foreground="#D0D0D0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="0,8"
                            Margin="0,0,6,0"
                            Cursor="Hand" />

                    <Button Grid.Column="1"
                            Content="{Binding Loc.ConfirmResetButton}"
                            Command="{Binding ConfirmResetDefaultsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#700008"
                            Foreground="#FFFFFF"
                            FontSize="12"
                            FontWeight="Bold"
                            CornerRadius="8"
                            Padding="0,8"
                            Margin="6,0,0,0"
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#8B0014" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#5C0006" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Panel>
</Window>
