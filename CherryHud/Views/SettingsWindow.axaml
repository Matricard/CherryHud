<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CherryHud.ViewModels"
        x:Class="CherryHud.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Loc.WindowTitle}"
        Icon="/Assets/logo.png"
        Width="470" Height="600"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="Transparent">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding $parent[Window].Close}" />
        <KeyBinding Gesture="Cmd+W" Command="{Binding $parent[Window].Close}" />
    </Window.KeyBindings>

    <Panel>
        <!-- Teinte d'arrière-plan : sombre obsidian transparent (~62%) quand active, gris fumée foncé quand inactive -->
        <Border x:Name="WindowBackgroundBorder" Background="#9E030408">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <Grid RowDefinitions="*,Auto" Margin="22,40,22,18">
        <!-- Body / Tabs -->
        <TabControl Grid.Row="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#8A8D9F" />
                    <Setter Property="Padding" Value="14,8" />
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#FF2A6D" />
                </Style>
            </TabControl.Styles>

            <!-- Onglet 1 : Affichage -->
            <TabItem Header="{Binding Loc.TabDisplay}">
                <ScrollViewer Margin="0,10,0,0" Padding="0,0,10,0">
                    <StackPanel Spacing="9">
                        <!-- Language Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.LanguageCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.LanguageCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedLanguageIndex}"
                                          Width="145"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Français" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Theme Card -->
                        <Border Background="#4E1C1F2D" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.ThemeCardTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.ThemeCardSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedThemeIndex}"
                                          Width="145"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="{Binding Loc.ThemeClassic}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Températures en blanc Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.WhiteTempTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.WhiteTempSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding KeepTemperaturesWhite}"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>

                        <!-- Mode Automatique Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.AutoModeTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.AutoModeSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding AutoGameMode}"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>

                        <!-- Position Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.PositionTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.PositionSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedPositionIndex}"
                                          Width="145"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="{Binding Loc.PositionTopLeft}" />
                                    <ComboBoxItem Content="{Binding Loc.PositionTopRight}" />
                                    <ComboBoxItem Content="{Binding Loc.PositionBottomLeft}" />
                                    <ComboBoxItem Content="{Binding Loc.PositionBottomRight}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Opacité Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc.OpacityTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OpacityPercent, StringFormat='{}{0}%'}"
                                               Foreground="#FF2A6D"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="40" Maximum="100"
                                        Value="{Binding OpacityPercent}"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 2 : Métriques -->
            <TabItem Header="{Binding Loc.TabMetrics}">
                <ScrollViewer Margin="0,10,0,0" Padding="0,0,10,0">
                    <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,8">
                        <StackPanel Spacing="8">
                            <!-- GPU -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#661422" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="GPU" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricGpu}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGpu}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- CPU -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#0E3D4F" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="CPU" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricCpu}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowCpu}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- VRAM -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#4E1A5B" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="VRAM" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricVram}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowVram}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- RAM -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#172F5E" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="RAM" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricRam}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowRam}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- BAT -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#523C0F" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="BAT" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricBattery}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowBattery}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- FPS -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#0F4725" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="FPS" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricFps}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowFps}" OnContent="" OffContent="" />
                            </Grid>

                            <Rectangle Height="1" Fill="#14FFFFFF" />

                            <!-- Graphique -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                                    <Border Background="#272A38" CornerRadius="5" Width="48" Height="22">
                                        <TextBlock Text="📈" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Loc.MetricGraph}" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGraph}" OnContent="" OffContent="" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 3 : Système & Rendu -->
            <TabItem Header="{Binding Loc.TabAdvanced}">
                <ScrollViewer Margin="0,10,0,0" Padding="0,0,10,0">
                    <StackPanel Spacing="9">
                        <!-- Libellé Mémoire GPU -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.GpuMemLabelTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.GpuMemLabelSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedGpuMemoryLabelIndex}"
                                          Width="130"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="VRAM" />
                                    <ComboBoxItem Content="GPU MEM" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Rafraîchissement Graphique -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.GraphFpsTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.GraphFpsSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{Binding SelectedGraphFpsIndex}"
                                          Width="130"
                                          FontSize="11.5">
                                    <ComboBoxItem Content="60 FPS" />
                                    <ComboBoxItem Content="120 FPS" />
                                    <ComboBoxItem Content="30 FPS" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Screen Recording Permission Card -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="13,9">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Loc.ScreenCaptureTitle}"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Loc.ScreenCaptureSubtitle}"
                                           Foreground="#8A8D9F"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding PermissionStatusText}"
                                               Foreground="{Binding PermissionStatusColor}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Loc.OpenSystemSettingsButton}"
                                            Command="{Binding OpenSystemSettingsCommand}"
                                            Background="#2600E5FF"
                                            Foreground="#00E5FF"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet 4 : À propos -->
            <TabItem Header="{Binding Loc.TabAbout}">
                <ScrollViewer Margin="0,10,0,0" Padding="0,0,10,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <!-- App Icon -->
                        <Border Width="72" Height="72"
                                CornerRadius="18"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                BoxShadow="0 6 20 0 #40000000"
                                Margin="0,0,0,10">
                            <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
                        </Border>

                        <!-- Titre & Version -->
                        <TextBlock Text="CherryHud"
                                    Foreground="#FFFFFF"
                                    FontSize="20"
                                    FontWeight="Heavy"
                                    HorizontalAlignment="Center" />

                        <TextBlock Text="Version 0.9.0 • .NET 10"
                                    Foreground="#D41630"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,4" />

                        <TextBlock Text="{Binding Loc.AboutDesc}"
                                    Foreground="#9E9E9E"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14" />

                        <!-- Carte récapitulative des fonctionnalités -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,14"
                                Width="380">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.AboutFeat1}"
                                               Foreground="#DCDCDC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🎮" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.AboutFeat2}"
                                               Foreground="#DCDCDC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🍒" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc.AboutFeat3}"
                                               Foreground="#DCDCDC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Carte Mises à jour -->
                        <Border Background="#24141724" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,12"
                                Width="380">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Loc.SoftwareUpdatesTitle}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc.SoftwareUpdatesSubtitle}"
                                               Foreground="#8A8D9F"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding Loc.CheckButton}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        Background="#267ED884"
                                        Foreground="#7ED884"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        CornerRadius="6"
                                        Padding="12,5"
                                        Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- Auteur, Technologie & Licence -->
                        <TextBlock Text="{Binding Loc.AuthorText}"
                                   Foreground="#7E8092"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding Loc.BuiltWithAvaloniaText}"
                                   Foreground="#6B6E82"
                                   FontSize="10.5"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />

                        <TextBlock Text="{Binding Loc.LicenseText}"
                                   Foreground="#5E6070"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Content="{Binding Loc.ResetDefaultsButton}"
                    Command="{Binding RequestResetDefaultsCommand}"
                    Background="Transparent"
                    Foreground="#8A8D9F"
                    FontSize="11.5"
                    Padding="0"
                    BorderThickness="0"
                    Cursor="Hand" />

            <Button Grid.Column="2"
                    Content="{Binding Loc.CloseButton}"
                    Click="Close_OnClick"
                    Background="#2600E676"
                    Foreground="#00E676"
                    FontSize="12"
                    FontWeight="Bold"
                    CornerRadius="8"
                    Padding="22,7"
                    Cursor="Hand" />
        </Grid>
    </Grid>

    <!-- Modal de confirmation de réinitialisation -->
    <Border IsVisible="{Binding IsResetConfirmationVisible}"
            Background="#C007080F">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="380"
                Background="#24141724"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,20"
                BoxShadow="0 10 30 0 #80000000">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Loc.ResetConfirmTitle}"
                               Foreground="#FFFFFF"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Loc.ResetConfirmMessage}"
                           Foreground="#B0B3C5"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="17" />

                <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                    <Button Grid.Column="0"
                            Content="{Binding Loc.CancelButton}"
                            Command="{Binding CancelResetDefaultsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#1AFFFFFF"
                            Foreground="#D0D0D0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="0,8"
                            Margin="0,0,6,0"
                            Cursor="Hand" />

                    <Button Grid.Column="1"
                            Content="{Binding Loc.ConfirmResetButton}"
                            Command="{Binding ConfirmResetDefaultsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#D41630"
                            Foreground="#FFFFFF"
                            FontSize="12"
                            FontWeight="Bold"
                            CornerRadius="8"
                            Padding="0,8"
                            Margin="6,0,0,0"
                            Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Panel>
</Window>
